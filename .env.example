# Example Environment Variables (No secrets in frontend or repository)
# For local development with Cloudflare Vite Plugin & D1, no cloud API tokens are required.

# Production Cloudflare Deployment (Optional for CI/CD)
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
# D1_DATABASE_ID=your_remote_d1_database_uuid
